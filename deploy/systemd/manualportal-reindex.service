[Unit]
Description=Manual Portal re-index worker
After=network.target

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/manualportal
Environment=DJANGO_ENV_FILE=/home/ubuntu/manualportal/.env
ExecStart=/home/ubuntu/manualportal/venv/bin/python manage.py process_reindex_jobs --sleep 5
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target