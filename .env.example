# Development defaults. Override these values in the production environment file.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_USE_X_FORWARDED_HOST=False
DJANGO_SECURE_PROXY_SSL_HEADER=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# Use inline indexing locally. Production should use False with the worker service.
DJANGO_REINDEX_INLINE=True

# Cloudflare R2 (S3-compatible storage)
USE_R2=False
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT_URL=
CLOUDFLARE_R2_MAX_UPLOAD_SIZE=1073741824
CLOUDFLARE_R2_MULTIPART_CHUNK_SIZE=52428800
CLOUDFLARE_R2_PRESIGNED_URL_EXPIRES=3600

SITE_CREATED_DATE=Jun 2026
SITE_REVISION_DATE=01 Jul 2026
SITE_REVISION_NO=Rev. 01
